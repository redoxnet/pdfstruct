<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>net8.0</TargetFramework>
    <RootNamespace>PdfStruct.Rendering</RootNamespace>

    <!-- NuGet -->
    <PackageId>PdfStruct.Rendering</PackageId>
    <Version>0.1.0-alpha.1</Version>
    <Authors>Jong Hyun Kim</Authors>
    <Company>RedoxNet</Company>
    <Copyright>Copyright (c) 2026 RedoxNet</Copyright>
    <Description>PDFium-backed page rasterisation for PdfStruct — renders pages to pixels and crops image regions. Implements PdfStruct's IPageRasterizer and IImageRasterizer; shared by image extraction and code decoding.</Description>
    <PackageTags>pdf;pdfium;rasterize;render;pdfstruct;image</PackageTags>
    <PackageLicenseExpression>Apache-2.0</PackageLicenseExpression>
    <PackageProjectUrl>https://github.com/redoxnet/pdfstruct</PackageProjectUrl>
    <RepositoryUrl>https://github.com/redoxnet/pdfstruct</RepositoryUrl>
    <RepositoryType>git</RepositoryType>
    <GenerateDocumentationFile>true</GenerateDocumentationFile>
  </PropertyGroup>

  <ItemGroup>
    <ProjectReference Include="..\PdfStruct\PdfStruct.csproj" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="Docnet.Core" />
    <PackageReference Include="SkiaSharp" />
  </ItemGroup>

</Project>
